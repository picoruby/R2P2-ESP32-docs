<%
# Locals: name (String, basename of src/images/examples/<name>[-dark].svg,
# generated by `rake breadboard:render`), alt (String).
%>
<figure class="not-prose my-6 overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800">
  <img class="block h-auto w-full dark:hidden" src="<%= relative_url "/images/examples/#{name}.svg" %>" alt="<%= alt %>" loading="lazy">
  <img class="hidden h-auto w-full dark:block" src="<%= relative_url "/images/examples/#{name}-dark.svg" %>" alt="<%= alt %>" loading="lazy">
</figure>
