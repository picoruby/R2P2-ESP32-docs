<% is_docs = resource.collection&.label.to_s == "docs" %>
<header data-pagefind-ignore class="sticky top-0 z-40 border-b border-neutral-200/80 bg-white/80 backdrop-blur dark:border-neutral-800/80 dark:bg-neutral-950/80">
  <div class="mx-auto flex h-16 max-w-screen-2xl items-center gap-4 px-4 sm:px-6">
    <% if is_docs %>
    <button
      type="button"
      data-sidebar-toggle
      aria-expanded="false"
      aria-label="<%= t("header.open_menu") %>"
      class="-ml-1.5 grid size-9 place-items-center rounded-lg text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800 lg:hidden"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <% end %>

    <a href="<%= relative_url '/' %>" class="flex shrink-0 items-center gap-2.5">
      <span class="grid size-8 place-items-center rounded-lg bg-brand-500 text-white">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M9 3v2M15 3v2M9 19v2M15 19v2M3 9h2M3 15h2M19 9h2M19 15h2"/></svg>
      </span>
      <span class="flex items-baseline gap-1.5 font-semibold tracking-tight text-neutral-900 dark:text-white">
        R2P2<span class="text-accent-600 dark:text-accent-400">ESP32</span>
      </span>
    </a>

    <% is_installer = data.slug == "installer" %>
    <nav class="ms-2 hidden items-center gap-1 md:flex">
      <a
        href="<%= relative_url in_locale("/docs/introduction/", site.locale) %>"
        class="rounded-md px-3 py-2 text-sm font-medium <% if is_docs %>text-brand-600 dark:text-brand-400<% else %>text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white<% end %>"
      ><%= t("nav.docs") %></a>
      <a
        href="<%= relative_url in_locale("/installer/", site.locale) %>"
        class="rounded-md px-3 py-2 text-sm font-medium <% if is_installer %>text-brand-600 dark:text-brand-400<% else %>text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white<% end %>"
      ><%= t("nav.installer") %></a>
    </nav>

    <div class="ms-auto flex items-center gap-1.5 sm:gap-2">
      <div class="relative hidden sm:block" data-search>
        <div class="flex w-48 items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-1.5 text-sm focus-within:border-brand-400 dark:border-neutral-800 dark:bg-neutral-900 dark:focus-within:border-brand-500 lg:w-64">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-neutral-400"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input
            type="search"
            data-search-input
            data-pagefind-url="<%= relative_url '/pagefind/pagefind.js' %>"
            data-label-no-results="<%= t("header.search_no_results") %>"
            data-label-unavailable="<%= t("header.search_unavailable") %>"
            autocomplete="off"
            spellcheck="false"
            placeholder="<%= t("header.search_placeholder") %>"
            aria-label="<%= t("header.search_placeholder") %>"
            class="w-full min-w-0 bg-transparent text-neutral-700 placeholder:text-neutral-400 focus:outline-none dark:text-neutral-200 dark:placeholder:text-neutral-500"
          />
          <kbd data-search-kbd class="ms-auto hidden shrink-0 rounded border border-neutral-300 bg-white px-1.5 py-0.5 font-mono text-[10px] text-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 lg:inline-block">Ctrl K</kbd>
        </div>
        <div
          data-search-results
          class="scrollbar-thin absolute end-0 top-full z-50 mt-2 hidden max-h-96 w-80 overflow-y-auto rounded-lg border border-neutral-200 bg-white py-2 shadow-lg dark:border-neutral-800 dark:bg-neutral-900 sm:w-96"
        ></div>
      </div>

      <details class="group relative">
        <summary
          class="flex list-none items-center gap-1 rounded-lg px-2 py-1.5 text-sm font-medium text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800 [&::-webkit-details-marker]:hidden"
          aria-label="<%= t("header.switch_language") %>"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg>
          <span class="hidden sm:inline"><%= locale_label(site.locale) %></span>
        </summary>
        <div class="absolute end-0 top-full z-50 mt-2 w-36 overflow-hidden rounded-lg border border-neutral-200 bg-white py-1 shadow-lg dark:border-neutral-800 dark:bg-neutral-900">
          <% site.config.available_locales.each do |locale| %>
          <a
            href="<%= relative_url in_locale(is_docs ? "/docs/#{data.slug}/" : (is_installer ? "/installer/" : "/"), locale) %>"
            class="block px-3 py-1.5 text-sm <%= locale.to_s == site.locale.to_s ? "font-semibold text-brand-600 dark:text-brand-400" : "text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800" %>"
          ><%= locale_label(locale) %></a>
          <% end %>
        </div>
      </details>

      <button
        type="button"
        data-theme-toggle
        aria-label="<%= t("header.toggle_theme") %>"
        class="grid size-9 place-items-center rounded-lg text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dark:hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
      </button>

      <a
        href="<%= site.data.site_metadata.repo %>"
        class="grid size-9 place-items-center rounded-lg text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"
        aria-label="GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.17c-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.79.55A10.53 10.53 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
      </a>
    </div>
  </div>
</header>
