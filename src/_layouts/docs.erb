---
layout: default
---

<% ordered_slugs = flatten_docs_nav(site.data.docs_nav) %>
<% current_index = ordered_slugs.index(data.slug) %>
<% prev_doc = current_index && current_index > 0 ? find_doc(site, ordered_slugs[current_index - 1], site.locale) : nil %>
<% next_doc = current_index && current_index < ordered_slugs.length - 1 ? find_doc(site, ordered_slugs[current_index + 1], site.locale) : nil %>
<% breadcrumb_ids = docs_breadcrumb_ids(site.data.docs_nav, data.slug) %>

<div class="mx-auto flex max-w-screen-2xl items-start">
  <div data-sidebar-overlay class="fixed inset-0 z-30 hidden bg-neutral-900/50 lg:hidden"></div>

  <div
    data-sidebar-panel
    data-pagefind-ignore
    class="scrollbar-thin fixed inset-y-0 start-0 z-40 w-72 -translate-x-full overflow-y-auto border-e border-neutral-200 bg-white pt-16 transition-transform duration-200 ease-in-out dark:border-neutral-800 dark:bg-neutral-950 lg:sticky lg:top-16 lg:z-0 lg:h-[calc(100vh-4rem)] lg:w-64 lg:shrink-0 lg:translate-x-0 lg:pt-0 lg:transition-none"
  >
    <%= render "docs_sidebar" %>
  </div>

  <div class="min-w-0 flex-1 px-4 py-10 sm:px-8 lg:px-10">
    <div class="mx-auto max-w-3xl">
      <header class="mb-8">
        <nav aria-label="Breadcrumb" data-pagefind-ignore class="mb-3 flex flex-wrap items-center gap-1.5 text-sm text-neutral-400 dark:text-neutral-500">
          <a href="<%= relative_url in_locale("/docs/introduction/", site.locale) %>" class="hover:text-neutral-700 dark:hover:text-neutral-300"><%= t("nav.docs") %></a>
          <% breadcrumb_ids.each do |id| %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m9 18 6-6-6-6"/></svg>
          <span><%= t("nav.sections.#{id}") %></span>
          <% end %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m9 18 6-6-6-6"/></svg>
          <span class="text-neutral-600 dark:text-neutral-300" aria-current="page"><%= data.title %></span>
        </nav>
        <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white"><%= data.title %></h1>
        <% if data.description %>
        <p class="mt-3 text-lg text-neutral-500 dark:text-neutral-400"><%= data.description %></p>
        <% end %>
      </header>

      <div
        data-docs-content
        class="prose prose-neutral max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-headings:font-semibold prose-a:text-accent-600 prose-a:no-underline hover:prose-a:underline dark:prose-a:text-accent-400 prose-code:before:content-none prose-code:after:content-none prose-img:rounded-lg"
      >
        <%= yield %>
      </div>

      <nav data-pagefind-ignore class="mt-12 grid grid-cols-1 gap-3 border-t border-neutral-200 pt-6 dark:border-neutral-800 sm:grid-cols-2">
        <% if prev_doc %>
        <a href="<%= relative_url prev_doc %>" class="group rounded-lg border border-neutral-200 p-4 hover:border-brand-300 dark:border-neutral-800 dark:hover:border-brand-700">
          <span class="text-xs font-medium text-neutral-400 dark:text-neutral-500"><%= t("pagination.previous") %></span>
          <span class="mt-1 flex items-center gap-1.5 font-medium text-neutral-800 group-hover:text-brand-600 dark:text-neutral-200 dark:group-hover:text-brand-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <%= prev_doc.data.title %>
          </span>
        </a>
        <% else %>
        <div></div>
        <% end %>

        <% if next_doc %>
        <a href="<%= relative_url next_doc %>" class="group rounded-lg border border-neutral-200 p-4 text-end hover:border-brand-300 dark:border-neutral-800 dark:hover:border-brand-700">
          <span class="text-xs font-medium text-neutral-400 dark:text-neutral-500"><%= t("pagination.next") %></span>
          <span class="mt-1 flex items-center justify-end gap-1.5 font-medium text-neutral-800 group-hover:text-brand-600 dark:text-neutral-200 dark:group-hover:text-brand-400">
            <%= next_doc.data.title %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </span>
        </a>
        <% end %>
      </nav>

      <div class="mt-8" data-pagefind-ignore>
        <a
          href="<%= site.data.site_metadata.repo_edit_base %>/<%= resource.relative_path %>"
          class="inline-flex items-center gap-1.5 text-sm text-neutral-400 hover:text-neutral-700 dark:text-neutral-500 dark:hover:text-neutral-200"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z"/></svg>
          <%= t("footer.edit_page") %>
        </a>
      </div>
    </div>
  </div>

  <div class="hidden shrink-0 xl:block xl:w-64 xl:px-6 xl:py-10" data-pagefind-ignore>
    <%= render "toc" %>
  </div>
</div>
